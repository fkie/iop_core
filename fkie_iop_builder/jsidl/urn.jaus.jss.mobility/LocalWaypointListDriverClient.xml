<?xml version="1.0" encoding="UTF-8"?>
<service_def name="LocalWaypointListDriverClient" id="urn:jaus:jss:mobility:LocalWaypointListDriverClient" version="1.1"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description>
    Client for LocalWaypointListDriverClient service used in e.g. OCU. </description>
  <assumptions>Messages may be delayed, lost or reordered.</assumptions>
  <references>
    <inherits_from name="listManagerClient" id="urn:jaus:jss:core:ListManagerClient" version="1.1" />
    <client_of name="LocalWaypointListDriver" id="urn:jaus:jss:mobility:LocalWaypointListDriver" version="1.1" />
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportTravelSpeed" declared_type_ref="LocalWaypointListDriver.ReportTravelSpeed"/>
      <declared_message_def name="ReportLocalWaypoint" declared_type_ref="LocalWaypointListDriver.ReportLocalWaypoint"/>
      <declared_message_def name="ReportTravelSpeedExt" declared_type_ref="LocalWaypointListDriver.ReportTravelSpeedExt"/>
      <declared_message_def name="ReportLocalWaypointExt" declared_type_ref="LocalWaypointListDriver.ReportLocalWaypointExt"/>
      <declared_message_def name="ReportActiveElement" declared_type_ref="LocalWaypointListDriver.ReportActiveElement"/>
    </input_set>
    <output_set>
      <declared_message_def name="ExecuteList" declared_type_ref="LocalWaypointListDriver.ExecuteList"/>
      <declared_message_def name="QueryTravelSpeed" declared_type_ref="LocalWaypointListDriver.QueryTravelSpeed"/>
      <declared_message_def name="QueryLocalWaypoint" declared_type_ref="LocalWaypointListDriver.QueryLocalWaypoint"/>
      <declared_message_def name="QueryTravelSpeedExt" declared_type_ref="LocalWaypointListDriver.QueryTravelSpeedExt"/>
      <declared_message_def name="QueryLocalWaypointExt" declared_type_ref="LocalWaypointListDriver.QueryLocalWaypointExt"/>
      <declared_message_def name="QueryActiveElement" declared_type_ref="LocalWaypointListDriver.QueryActiveElement"/>
      <!-- Add message type, this will not be handled in protocol -->
      <!-- <declared_message_def name="SetLocalWaypoint" declared_type_ref="LocalWaypointListDriver.SetLocalWaypoint"/> -->
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior>
    <start state_machine_name="listManagerClient.managementClient.accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="listManagerClient.managementClient.accessControlClient.eventsClient.transport.ReceiveFSM" interpretation="extending ReceiveFSM of base service (transport)">
      <state name="Receiving" initial_state="Ready" interpretation="redefine state in order to extend">
        <state name="Receiving" initial_state="Ready">
          <state name="Ready">
            <default_state>
              <transition name="ReportTravelSpeed">
                <parameter type="ReportTravelSpeed" value="msg" interpretation="enveloped ReportTravelSpeed message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportTravelSpeed" interpretation="handle a ReportTravelSpeed message">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>

              <transition name="ReportLocalWaypoint">
                <parameter type="ReportLocalWaypoint" value="msg" interpretation="enveloped ReportLocalWaypoint message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportLocalWaypoint" interpretation="handle a ReportLocalWaypoint message">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>

              <transition name="ReportTravelSpeedExt">
                <parameter type="ReportTravelSpeedExt" value="msg" interpretation="enveloped ReportTravelSpeed message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportTravelSpeedExt" interpretation="handle a ReportTravelSpeed message">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>

              <transition name="ReportLocalWaypointExt">
                <parameter type="ReportLocalWaypointExt" value="msg" interpretation="enveloped ReportLocalWaypoint message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportLocalWaypointExt" interpretation="handle a ReportLocalWaypoint message">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>

              <transition name="ReportActiveElement">
                <parameter type="ReportActiveElement" value="msg" interpretation="enveloped ReportActiveElement message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportActiveElement" interpretation="handle a ReportActiveElement message">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>
            </default_state>
          </state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
