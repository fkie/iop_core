<?xml version="1.0" encoding="UTF-8"?>
<service_def name="LocalWaypointDriverClient" id="urn:jaus:jss:mobility:LocalWaypointDriverClient" version="1.1"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description>
    The Local Waypoint Driver Client allows control of the Local Waypoint Driver service within the ROS/IOP Bridge.
  </description>
  <assumptions>Messages may be delayed, lost or reordered.</assumptions>
  <references>
    <inherits_from name="managementClient" id="urn:jaus:jss:core:ManagementClient" version="1.1"/>
    <client_of name="LocalWaypointDriver" id="urn:jaus:jss:mobility:LocalWaypointDriver" version="1.1" />
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportTravelSpeed" declared_type_ref="LocalWaypointDriver.ReportTravelSpeed"/>
      <declared_message_def name="ReportLocalWaypoint" declared_type_ref="LocalWaypointDriver.ReportLocalWaypoint"/>
      <declared_message_def name="ReportTravelSpeedExt" declared_type_ref="LocalWaypointDriver.ReportTravelSpeedExt"/>
      <declared_message_def name="ReportLocalWaypointExt" declared_type_ref="LocalWaypointDriver.ReportLocalWaypointExt"/>
    </input_set>
    <output_set>
      <declared_message_def name="SetTravelSpeed" declared_type_ref="LocalWaypointDriver.SetTravelSpeed"/>
      <declared_message_def name="SetLocalWaypoint" declared_type_ref="LocalWaypointDriver.SetLocalWaypoint"/>
      <declared_message_def name="QueryTravelSpeed" declared_type_ref="LocalWaypointDriver.QueryTravelSpeed"/>
      <declared_message_def name="QueryLocalWaypoint" declared_type_ref="LocalWaypointDriver.QueryLocalWaypoint"/>
      <declared_message_def name="QueryTravelSpeedExt" declared_type_ref="LocalWaypointDriver.QueryTravelSpeedExt"/>
      <declared_message_def name="QueryLocalWaypointExt" declared_type_ref="LocalWaypointDriver.QueryLocalWaypointExt"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior>
    <start state_machine_name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM">
      <state name="Receiving" initial_state="Ready">
        <state name="Ready">
          <default_state>

            <transition name="ReportTravelSpeed">
              <parameter type="ReportTravelSpeed" value="msg" interpretation="enveloped Report Travel Speed message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportTravelSpeed" interpretation="handle a Report Travel Speed message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportLocalWaypoint">
              <parameter type="ReportLocalWaypoint" value="msg" interpretation="enveloped Report Local Waypoint message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportLocalWaypoint" interpretation="handle a Report Local Waypoint message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportTravelSpeedExt">
              <parameter type="ReportTravelSpeedExt" value="msg" interpretation="enveloped Report Travel Speed message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportTravelSpeedExt" interpretation="handle a Report Travel Speed message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportLocalWaypointExt">
              <parameter type="ReportLocalWaypointExt" value="msg" interpretation="enveloped Report Local Waypoint message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportLocalWaypointExt" interpretation="handle a Report Local Waypoint message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>
          </default_state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
