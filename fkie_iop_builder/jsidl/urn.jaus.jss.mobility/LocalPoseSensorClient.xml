<?xml version="1.0" encoding="UTF-8"?>
<service_def name="LocalPoseSensorClient" id="urn:jaus:jss:mobility:LocalPoseSensorClient" version="1.1"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description>The The client service to get the local position sensor data.</description>
  <assumptions>Messages may be delayed, lost or reordered.</assumptions>
  <references>
    <inherits_from name="accessControlClient" id="urn:jaus:jss:core:AccessControlClient" version="1.1"/>
    <client_of name="LocalPoseSensor" id="urn:jaus:jss:mobility:LocalPoseSensor" version="1.1"/>
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportLocalPose" declared_type_ref="LocalPoseSensor.ReportLocalPose"/>
      <declared_message_def name="ReportLocalPoseExt" declared_type_ref="LocalPoseSensor.ReportLocalPoseExt"/>
    </input_set>
    <output_set>
      <declared_message_def name="SetLocalPose" declared_type_ref="LocalPoseSensor.SetLocalPose"/>
      <declared_message_def name="SetLocalPoseExt" declared_type_ref="LocalPoseSensor.SetLocalPoseExt"/>
      <declared_message_def name="QueryLocalPose" declared_type_ref="LocalPoseSensor.QueryLocalPose"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior>
    <start state_machine_name="accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready.NotControlled"/>
    <state_machine name="accessControlClient.eventsClient.transport.ReceiveFSM" interpretation="extending ReceiveFSM of base service (transport)">
      <state name="Receiving" initial_state="Ready" interpretation="redefine state in order to extend">
        <state name="Ready" initial_state="NotControlled" interpretation="redefine state in order to extend">
          <state name="NotControlled" interpretation="redefine state in order to extend">
            <default_state>
              <transition name="ReportLocalPose">
                <parameter type="ReportLocalPose" value="msg" interpretation="enveloped local pose message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportLocalPose" interpretation="handle the Report Local Pose message with the current local position">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>

              <transition name="ReportLocalPoseExt">
                <parameter type="ReportLocalPoseExt" value="msg" interpretation="enveloped local pose message"/>
                <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                <internal/>
                <action name="handleReportLocalPoseExt" interpretation="handle the Report Local Pose message with the current local position">
                  <argument value="msg"/>
                  <argument value="transportData"/>
                </action>
              </transition>
            </default_state>
          </state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
