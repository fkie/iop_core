<?xml version="1.0" encoding="UTF-8"?>
<service_def name="GlobalWaypointDriverClient" id="urn:jaus:jss:mobility:GlobalWaypointDriverClient" version="1.1"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description>
    The Global Waypoint Driver Client allows control of the Global Waypoint Driver service within the ROS/IOP Bridge.
  </description>
  <assumptions>Messages may be delayed, lost or reordered.</assumptions>
  <references>
    <inherits_from name="managementClient" id="urn:jaus:jss:core:ManagementClient" version="1.1"/>
    <client_of name="GlobalWaypointDriver" id="urn:jaus:jss:mobility:GlobalWaypointDriver" version="1.1"/>
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportTravelSpeed" declared_type_ref="GlobalWaypointDriver.ReportTravelSpeed"/>
      <declared_message_def name="ReportGlobalWaypoint" declared_type_ref="GlobalWaypointDriver.ReportGlobalWaypoint"/>
      <declared_message_def name="ReportTravelSpeedExt" declared_type_ref="GlobalWaypointDriver.ReportTravelSpeedExt"/>
      <declared_message_def name="ReportGlobalWaypointExt" declared_type_ref="GlobalWaypointDriver.ReportGlobalWaypointExt"/>
    </input_set>
    <output_set>
      <declared_message_def name="SetTravelSpeed" declared_type_ref="GlobalWaypointDriver.SetTravelSpeed"/>
      <declared_message_def name="SetGlobalWaypoint" declared_type_ref="GlobalWaypointDriver.SetGlobalWaypoint"/>
      <declared_message_def name="QueryTravelSpeed" declared_type_ref="GlobalWaypointDriver.QueryTravelSpeed"/>
      <declared_message_def name="QueryGlobalWaypoint" declared_type_ref="GlobalWaypointDriver.QueryGlobalWaypoint"/>
      <declared_message_def name="QueryTravelSpeedExt" declared_type_ref="GlobalWaypointDriver.QueryTravelSpeedExt"/>
      <declared_message_def name="QueryGlobalWaypointExt" declared_type_ref="GlobalWaypointDriver.QueryGlobalWaypointExt"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior>
    <start state_machine_name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM">
      <state name="Receiving" initial_state="Ready">
        <state name="Ready">
          <default_state>

            <transition name="ReportTravelSpeed">
              <parameter type="ReportTravelSpeed" value="msg" interpretation="enveloped Report Travel Speed message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportTravelSpeed" interpretation="handle a Report Travel Speed message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportGlobalWaypoint">
              <parameter type="ReportGlobalWaypoint" value="msg" interpretation="enveloped Report Global Waypoint message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportGlobalWaypoint" interpretation="handle a Report Global Waypoint message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportTravelSpeedExt">
              <parameter type="ReportTravelSpeedExt" value="msg" interpretation="enveloped Report Travel Speed message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportTravelSpeedExt" interpretation="handle a Report Travel Speed message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

            <transition name="ReportGlobalWaypointExt">
              <parameter type="ReportGlobalWaypointExt" value="msg" interpretation="enveloped Report Global Waypoint message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportGlobalWaypointExt" interpretation="handle a Report Global Waypoint message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>

          </default_state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
