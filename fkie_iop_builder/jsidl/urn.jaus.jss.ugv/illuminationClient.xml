<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="IlluminationServiceClient" id="urn:jaus:jss:ugv:IlluminationServiceClient" version="1.0"
    xmlns="urn:jaus:jsidl:1.1"
    xmlns:ns2="urn:jaus:jsidl:plus">
    <description xml:space="preserve">The Illumination Service client.</description>
    <assumptions xml:space="preserve">Messages may be delayed, lost or reordered.</assumptions>
    <references>
        <inherits_from name="accessControlClient" id="urn:jaus:jss:core:AccessControlClient" version="1.1"/>
        <client_of name="IlluminationService" id="urn:jaus:jss:ugv:IlluminationService" version="1.0"/>
    </references>
    <message_set>
        <input_set>
            <declared_message_def name="ReportIlluminationState" declared_type_ref="IlluminationService.ReportIlluminationState" />
            <declared_message_def name="ReportIlluminationConfiguration" declared_type_ref="IlluminationService.ReportIlluminationConfiguration" />
        </input_set>
        <output_set>
            <declared_message_def name="QueryIlluminationState" declared_type_ref="IlluminationService.QueryIlluminationState" />
            <declared_message_def name="QueryIlluminationConfiguration" declared_type_ref="IlluminationService.QueryIlluminationConfiguration" />
            <declared_message_def name="SetIlluminationState" declared_type_ref="IlluminationService.SetIlluminationState" />
        </output_set>
    </message_set>
    <internal_events_set/>
    <protocol_behavior>
        <start state_machine_name="accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
        <state_machine name="accessControlClient.eventsClient.transport.ReceiveFSM">
            <state name="Receiving" initial_state="Ready">
                <state name="Ready">
                    <default_state>

                        <transition name="ReportIlluminationState">
                            <parameter type="ReportIlluminationState" value="msg" interpretation="enveloped Report Illumination State message"/>
                            <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                            <internal/>
                            <action name="handleReportIlluminationState" interpretation="handle a Report Illumination State message">
                                <argument value="msg"/>
                                <argument value="transportData"/>
                            </action>
                        </transition>

                        <transition name="ReportIlluminationConfiguration">
                            <parameter type="ReportIlluminationConfiguration" value="msg" interpretation="enveloped Report Illumination Configuration message"/>
                            <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
                            <internal/>
                            <action name="handleReportIlluminationConfiguration" interpretation="handle a Report Illumination Configuration message">
                                <argument value="msg"/>
                                <argument value="transportData"/>
                            </action>
                        </transition>

                    </default_state>
                </state>
            </state>
        </state_machine>
    </protocol_behavior>
</service_def>
