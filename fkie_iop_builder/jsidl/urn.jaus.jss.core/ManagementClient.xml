<?xml version="1.0" encoding="UTF-8"?>
<service_def name="ManagementClient" id="urn:jaus:jss:core:ManagementClient" version="1.1"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:plus="urn:jaus:jsidl:plus">
  <description>The Management Service Client provides a state machine for component
    life-cycle management to help  understand how the component will
    react to commands and queries.</description>
  <assumptions>Messages may be delayed, lost or reordered.</assumptions>
  <references>
    <inherits_from name="accessControlClient" id="urn:jaus:jss:core:AccessControlClient" version="1.1"/>
    <client_of name="Management" id="urn:jaus:jss:core:Management" version="1.1"/>
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportStatus" declared_type_ref="Management.ReportStatus"/>
    </input_set>
    <output_set>
      <declared_message_def name="Shutdown" declared_type_ref="Management.Shutdown"/>
      <declared_message_def name="Standby" declared_type_ref="Management.Standby"/>
      <declared_message_def name="Resume" declared_type_ref="Management.Resume"/>
      <declared_message_def name="Reset" declared_type_ref="Management.Reset"/>
      <declared_message_def name="SetEmergency" declared_type_ref="Management.SetEmergency"/>
      <declared_message_def name="ClearEmergency" declared_type_ref="Management.ClearEmergency"/>
      <declared_message_def name="QueryStatus" declared_type_ref="Management.QueryStatus"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior>
    <start state_machine_name="accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="accessControlClient.eventsClient.transport.ReceiveFSM">
      <state name="Receiving" initial_state="Ready">
        <state name="Ready">
          <default_state>
            <transition name="accessControlClient.eventsClient.transport.Receive">
              <parameter type="ReportStatus" value="msg"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData"/>
              <internal/>
              <action name="reportStatus">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>
          </default_state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
