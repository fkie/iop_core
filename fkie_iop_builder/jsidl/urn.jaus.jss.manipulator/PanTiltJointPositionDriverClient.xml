<?xml version="1.1" encoding="UTF-8"?>
<service_def name="PanTiltJointPositionDriverClient" id="urn:jaus:jss:manipulator:PanTiltJointPositionDriverClient" version="2.0"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description xml:space="preserve">
    Client/Consumer Service for the Pan Tilt Joint Position Driver.
  </description>
  <assumptions> Messages may be delayed, lost, or reordered. </assumptions>
  <references>
    <inherits_from name="managementClient" id="urn:jaus:jss:core:ManagementClient" version="1.1"/>
    <client_of name="PanTiltJointPositionDriver" id="urn:jaus:jss:manipulator:PanTiltJointPositionDriver" version="2.0" />
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportCommandedPanTiltJointPositions" declared_type_ref="PanTiltJointPositionDriver.ReportCommandedPanTiltJointPositions"/>
    </input_set>
    <output_set>
      <declared_message_def name="QueryCommandedPanTiltJointPositions" declared_type_ref="PanTiltJointPositionDriver.QueryCommandedPanTiltJointPositions"/>
      <declared_message_def name="SetPanTiltJointPositions" declared_type_ref="PanTiltJointPositionDriver.SetPanTiltJointPositions"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior is_stateless="false">
    <start state_machine_name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="managementClient.accessControlClient.eventsClient.transport.ReceiveFSM">
      <state name="Receiving" initial_state="Ready">
        <state name="Ready">
          <default_state>
            <transition name="ReportCommandedPanTiltJointPositions">
              <parameter type="ReportCommandedPanTiltJointPositions" value="msg" interpretation="enveloped ReportCommandedPanTiltJointPositions message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportCommandedPanTiltJointPositions" interpretation="handle a ReportCommandedPanTiltJointPositions message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>
          </default_state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
