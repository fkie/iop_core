<?xml version="1.1" encoding="UTF-8"?>
<service_def name="ManipulatorSpecificationServiceClient" id="urn:jaus:jss:manipulator:ManipulatorSpecificationServiceClient" version="2.0"
  xmlns="urn:jaus:jsidl:1.1"
  xmlns:ns2="urn:jaus:jsidl:plus">
  <description xml:space="preserve">
    This client service is used to get description of manipulator arm from ManipulatorSpecificationService.
  </description>
  <assumptions> Messages may be delayed, lost, or reordered. </assumptions>
  <references>
    <inherits_from name="eventsClient" id="urn:jaus:jss:core:EventsClient" version="1.1"/>
    <client_of name="ManipulatorSpecificationService" id="urn:jaus:jss:manipulator:ManipulatorSpecificationService" version="2.0" />
  </references>
  <message_set>
    <input_set>
      <declared_message_def name="ReportManipulatorSpecifications" declared_type_ref="ManipulatorSpecificationService.ReportManipulatorSpecifications"/>
    </input_set>
    <output_set>
      <declared_message_def name="QueryManipulatorSpecifications" declared_type_ref="ManipulatorSpecificationService.QueryManipulatorSpecifications"/>
    </output_set>
  </message_set>
  <internal_events_set/>
  <protocol_behavior is_stateless="false">
    <start state_machine_name="eventsClient.transport.ReceiveFSM" state_name="Receiving.Ready"/>
    <state_machine name="eventsClient.transport.ReceiveFSM" interpretation="extending ReceiveFSM of base service (transport)">
      <state name="Receiving" initial_state="Ready" interpretation="redefine state in order to extend">
        <state name="Ready">
          <default_state>
            <transition name="ReportManipulatorSpecifications">
              <parameter type="ReportManipulatorSpecifications" value="msg" interpretation="enveloped report manipulator specifications message"/>
              <parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
              <internal/>
              <action name="handleReportManipulatorSpecifications" interpretation="handle a Report Manipulator Specs message">
                <argument value="msg"/>
                <argument value="transportData"/>
              </action>
            </transition>
          </default_state>
        </state>
      </state>
    </state_machine>
  </protocol_behavior>
</service_def>
