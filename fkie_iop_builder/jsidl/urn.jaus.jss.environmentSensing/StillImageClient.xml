<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="StillImageClient" id="urn:jaus:jss:environmentSensing:StillImageClient" version="2.0"
	xmlns="urn:jaus:jsidl:1.1"
	xmlns:ns2="urn:jaus:jsidl:plus">
	<description xml:space="preserve">This service provides access to the capabilities and 
		configuration of a camera, allowing the controlling component to set the camera 
		to a particular operational profile and to obtain images from the camera.  While 
		this service reports each image individually, the Events service can be used 
		to automatically report images at a specified rate thereby simulating video 
		(such as is typically done to create an MJPEG video stream).</description>
	<assumptions xml:space="preserve">Messages may be delayed, lost or reordered.</assumptions>
	<references>
		<inherits_from name="visualSensorClient" id="urn:jaus:jss:environmentSensing:VisualSensorClient" version="2.0"/>
		<client_of name="StillImage" id="urn:jaus:jss:environmentSensing:StillImage" version="2.0"/>
	</references>
	<message_set>
		<input_set>
			<declared_message_def name="ReportStillImageData" declared_type_ref="StillImage.ReportStillImageData"/>
			<declared_message_def name="ReportStillImageDataExt" declared_type_ref="StillImage.ReportStillImageDataExt"/>
			<declared_message_def name="ReportStillImageSensorConfiguration" declared_type_ref="StillImage.ReportStillImageSensorConfiguration"/>
			<declared_message_def name="ReportStillImageSensorCapabilities" declared_type_ref="StillImage.ReportStillImageSensorCapabilities"/>
		</input_set>
		<output_set>
			<declared_message_def name="SetStillImageSensorConfiguration" declared_type_ref="StillImage.SetStillImageSensorConfiguration"/>
			<declared_message_def name="QueryStillImageData" declared_type_ref="StillImage.QueryStillImageData"/>
			<declared_message_def name="QueryStillImageDataExt" declared_type_ref="StillImage.QueryStillImageDataExt"/>
			<declared_message_def name="QueryStillImageSensorConfiguration" declared_type_ref="StillImage.QueryStillImageSensorConfiguration"/>
			<declared_message_def name="QueryStillImageSensorCapabilities" declared_type_ref="StillImage.QueryStillImageSensorCapabilities"/>
		</output_set>
	</message_set>
	<internal_events_set/>
	<protocol_behavior is_stateless="false">
		<start state_machine_name="VisualSensorClient.AccessControlClient.EventsClient.Transport.ReceiveFSM" state_name="Receiving.Ready"/>
		<state_machine name="VisualSensorClient.AccessControlClient.EventsClient.Transport.ReceiveFSM">
			<state name="Receiving" initial_state="Ready">
				<state name="Ready">
					<default_state>
						<transition name="ReportStillImageData">
							<parameter type="ReportStillImageData" value="msg" interpretation="enveloped ReportStillImageData message"/>
							<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
							<internal/>
							<action name="handleReportStillImageData" interpretation="">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>

						<transition name="ReportStillImageDataExt">
							<parameter type="ReportStillImageDataExt" value="msg" interpretation="enveloped ReportStillImageDataExt message"/>
							<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
							<internal/>
							<action name="handleReportStillImageDataExt" interpretation="">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>

						<transition name="ReportStillImageSensorConfiguration">
							<parameter type="ReportStillImageSensorConfiguration" value="msg" interpretation="enveloped ReportStillImageSensorConfiguration message"/>
							<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
							<internal/>
							<action name="handleReportStillImageSensorConfiguration" interpretation="">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>

						<transition name="ReportStillImageSensorCapabilities">
							<parameter type="ReportStillImageSensorCapabilities" value="msg" interpretation="enveloped ReportStillImageSensorCapabilities message"/>
							<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transport data"/>
							<internal/>
							<action name="handleReportStillImageSensorCapabilities" interpretation="">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>

					</default_state>
				</state>
			</state>
		</state_machine>
	</protocol_behavior>
</service_def>
