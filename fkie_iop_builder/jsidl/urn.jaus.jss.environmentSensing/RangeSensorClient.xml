<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="RangeSensorClient" id="urn:jaus:jss:environmentSensing:RangeSensorClient" version="2.0"
	xmlns="urn:jaus:jsidl:1.1"
	xmlns:ns2="urn:jaus:jsidl:plus">
	<description xml:space="preserve">The client for RangeSensor service in IOP Bridge</description>
	<assumptions xml:space="preserve">Messages may be delayed, lost or reordered.</assumptions>
	<references>
		<inherits_from name="accessControlClient" id="urn:jaus:jss:core:AccessControlClient" version="1.1"/>
		<client_of name="RangeSensor" id="urn:jaus:jss:environmentSensing:RangeSensor" version="2.0"/>
	</references>
	<message_set>
		<input_set>
			<declared_message_def name="ConfirmSensorConfiguration" declared_type_ref="RangeSensor.ConfirmSensorConfiguration"/>
			<declared_message_def name="ReportRangeSensorCapabilities" declared_type_ref="RangeSensor.ReportRangeSensorCapabilities"/>
			<declared_message_def name="ReportRangeSensorConfiguration" declared_type_ref="RangeSensor.ReportRangeSensorConfiguration"/>
			<declared_message_def name="ReportRangeSensorData" declared_type_ref="RangeSensor.ReportRangeSensorData"/>
			<declared_message_def name="ReportRangeSensorCompressedData" declared_type_ref="RangeSensor.ReportRangeSensorCompressedData"/>
			<declared_message_def name="ReportSensorGeometricProperties" declared_type_ref="RangeSensor.ReportSensorGeometricProperties"/>
		</input_set>
		<output_set>
			<declared_message_def name="SetRangeSensorConfiguration" declared_type_ref="RangeSensor.SetRangeSensorConfiguration"/>
			<declared_message_def name="QuerySensorGeometricProperties" declared_type_ref="RangeSensor.QuerySensorGeometricProperties"/>
			<declared_message_def name="QueryRangeSensorCompressedData" declared_type_ref="RangeSensor.QueryRangeSensorCompressedData"/>
			<declared_message_def name="QueryRangeSensorData" declared_type_ref="RangeSensor.QueryRangeSensorData"/>
			<declared_message_def name="QueryRangeSensorCapabilities" declared_type_ref="RangeSensor.QueryRangeSensorCapabilities"/>
			<declared_message_def name="QueryRangeSensorConfiguration" declared_type_ref="RangeSensor.QueryRangeSensorConfiguration"/>
		</output_set>
	</message_set>
	<internal_events_set/>
	<protocol_behavior is_stateless="false">
		<start state_machine_name="accessControlClient.EventsClient.Transport.ReceiveFSM" state_name="Receiving.Ready"/>
		<state_machine name="accessControlClient.EventsClient.Transport.ReceiveFSM">
			<state name="Receiving" initial_state="Ready">
				<state name="Ready">
					<default_state>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ConfirmSensorConfiguration" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleConfirmSensorConfiguration" interpretation="handle ConfirmSensorConfiguration after setSensorConfiguration was send">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ReportRangeSensorCapabilities" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleReportRangeSensorCapabilities">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ReportRangeSensorConfiguration" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleReportRangeSensorConfiguration">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ReportRangeSensorData" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleReportRangeSensorData">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ReportRangeSensorCompressedData" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleReportRangeSensorCompressedData">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
						<transition name="accessControl.events.transport.Receive">
							<parameter type="ReportSensorGeometricProperties" value="msg" />
							<parameter type="Receive.Body.ReceiveRec" value="transportData" />
							<internal/>
							<action name="handleReportSensorGeometricProperties">
								<argument value="msg"/>
								<argument value="transportData"/>
							</action>
						</transition>
					</default_state>
				</state>
			</state>
		</state_machine>
	</protocol_behavior>
</service_def>
