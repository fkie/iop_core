								</action>
								<action name="removeAllHandoffRequests" interpretation="Removes all requests for handoff, flushing the queue and stopping all handoff request timers."/>
								<action name="sendConfirmHandoffRequestToAll" interpretation="Send a ConfirmHandoffRequest message to all pending clients">
									<argument value=" 'DENIED' "/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="ConfirmReleaseControl" value="msg" interpretation="enveloped Confirm Release Control message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
