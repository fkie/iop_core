	</internal_events_set>
	<protocol_behavior is_stateless="false">
		<start state_machine_name="accessControl.events.transport.ReceiveFSM" state_name="Receiving.Ready.NotControlled"/>
		<state_machine name="accessControl.events.transport.ReceiveFSM" interpretation="Extending ReceiveFSM from base">
			<state name="Receiving" initial_state="Ready" interpretation="redefine state in order to extend">
				<state name="Ready" initial_state="NotControlled" interpretation="redefine state in order to extend">

					<!-- default state A: Receive query messages -->
					<transition name="accessControl.events.transport.Receive">
						<parameter type="QueryHandoffDecisionTimeout" value="msg" interpretation="enveloped Query Handoff Decision Timeout message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="sendReportHandoffDecisionTimeout" interpretation="Send a ReportHandoffDecisionTimeout message to querying client">
							<argument value="transportData"/>
						</action>
					</transition>

					<transition name="accessControl.events.transport.Receive">
						<parameter type="QueryHandoffRequestTimeout" value="msg" interpretation="enveloped Query Handoff Request Timeout message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="sendReportHandoffRequestTimeout" interpretation="Send a ReportHandoffRequestTimeout message to querying client">
							<argument value="transportData"/>
						</action>
					</transition>

					<!--NotControlled-->
					<state name="NotControlled" initial_state="Available">

						<state name="NotAvailable">
							<!-- B -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'NOT_AVAILABLE' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RemoveHandoffRequest" value="msg" interpretation="enveloped Remove Handoff Request message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'NOT_AVAILABLE' "/>
									<argument value="transportData"/>
								</action>
							</transition>

						</state>

						<state name="Available">
							<!-- C -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'SERVICE_NOT_CONTROLLED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RemoveHandoffRequest" value="msg" interpretation="enveloped Remove Handoff Request message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'SERVICE_NOT_CONTROLLED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

						</state>

					</state>					<!--End NotControlled-->

					<!--Controlled-->
					<state name="Controlled" initial_state="Available">
						<!-- When leaving controlled state, flush the queue and send notifications to anyone waiting -->
						<exit>
							<!-- F -->
							<action name="removeAllHandoffRequests" interpretation="Removes all requests for handoff, flushing the queue and stopping all handoff request timers."/>
							<action name="sendConfirmHandoffRequestToAll" interpretation="Send a ConfirmHandoffRequest message to all pending clients">
								<argument value=" 'SERVICE_NOT_CONTROLLED' "/>
							</action>
						</exit>

						<state name="NotAvailable">
							<!-- D -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'NOT_AVAILABLE' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RemoveHandoffRequest" value="msg" interpretation="enveloped Remove Handoff Request message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isQueued( transportData )" interpretation="Returns True if the source of the request is queued."/>
								<internal/>
								<action name="removeHandoffRequest" interpretation="Removes the request for handoff identified by this client and ID from the queue of handoff requests and stops both the handoff request and handoff timers for this request.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to requesting client">
									<argument value=" 'REMOVED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RemoveHandoffRequest" value="msg" interpretation="enveloped Remove Handoff Request message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="!isQueued( transportData )" interpretation="Returns True if the source of the request is NOT queued."/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to requesting client">
									<argument value=" 'REMOVED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<!-- <transition name="HandoffRequestTimeoutEvent">
								<parameter type="unsigned byte" value="requestID" interpretation="ID from the Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="resetHandoffRequestTimer" interpretation="Resets the handoff request timer corresponding to the client and ID.">
									<argument value="requestID" interpretation="ID from the RequestHandoff message that timed out."/>
									<argument value="transportData" interpretation="transportData associated with the client whose request timed out."/>
								</action>
							</transition> -->

							<!-- <transition name="HandoffDecisionTimeoutEvent">
								<parameter type="unsigned byte" value="requestReleaseControlID" interpretation="ID from the Handoff Decision Timeout Event"/>
								<internal/>
								<action name="resetHandoffDecisionTimer" interpretation="Resets the handoff decision timer associated with the corresponding RequestReleaseControl ID.">
									<argument value="requestReleaseControlID" interpretation="ID from the RequestReleaseControl message that was not responded to."/>
								</action>
							</transition> -->

						</state>

						<state name="Available">
							<!-- E -->

							<!-- Request Handoff -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isDefaultAuthorityGreater(msg) &amp;&amp; isQueued( transportData )" interpretation="True if the default authority is greater than requesting authority and the source specified by a JAUS address is in the handoff queue."/>
								<internal/>
								<action name="removeHandoffRequest" interpretation="Removes the request for handoff identified by this client and ID from the queue of handoff requests and stops both the handoff request and handoff timers for this request.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'INSUFFICIENT_AUTHORITY' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isDefaultAuthorityGreater(msg) &amp;&amp; !isQueued( transportData )" interpretation="True if the default authority is greater than requesting authority and the source specified by a JAUS address is NOT in the handoff queue."/>
								<internal/>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'INSUFFICIENT_AUTHORITY' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isControllingClient( transportData ) &amp;&amp; !isDefaultAuthorityGreater(msg)" interpretation="True if the requesting client is the current controller AND the default authority is NOT greater than that of requesting client."/>
								<internal/>
								<action name="accessControl.setAuthority">
									<argument value="msg"/>
								</action>
								<action name="accessControl.resetHandoffRequestTimer" interpretation="Resets the handoff request timer corresponding to the client and ID.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'GRANTED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="!isControllingClient( transportData ) &amp;&amp; !isDefaultAuthorityGreater(msg) &amp;&amp; isQueued( transportData ) &amp;&amp; isDeferred( transportData )" interpretation="True if requesting client is not the current controller and has at least the default authority and the source of the request is queued but has been deferred by the current controller."/>
								<internal/>
								<action name="updateHandoffRequest" interpretation="Updates the request for handoff identified by ID in the queue of handoff requests.">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
								<action name="resetHandoffRequestTimer" interpretation="Resets the handoff request timer corresponding to the client and ID.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'DEFERRED' "/>
									<argument value="transportData"/>
								</action>
								<action name="sendRequestReleaseControl" interpretation="Sends a HandoffController.RequestReleaseControl message to the current controller">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="!isControllingClient( transportData ) &amp;&amp; !isDefaultAuthorityGreater(msg) &amp;&amp; isQueued( transportData )" interpretation="True if requesting client is not the current controller and has at least the default authority and the source of the request is queued."/>
								<internal/>
								<action name="queueHandoffRequest" interpretation="Updates the request for handoff identified by JAUS ID in the queue of handoff requests.">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
								<action name="resetHandoffRequestTimer" interpretation="Resets the handoff request timer corresponding to the client and ID.">
									<argument value="transportData"/>
								</action>
								<!-- <action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'QUEUED' "/>
									<argument value="transportData"/>
								</action> -->
								<action name="sendRequestReleaseControl" interpretation="Sends a HandoffController.RequestReleaseControl message to the current controller">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="RequestHandoff" value="msg" interpretation="enveloped Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="!isControllingClient( transportData ) &amp;&amp; !isDefaultAuthorityGreater(msg) &amp;&amp; !isQueued( transportData )" interpretation="True if requesting client is not the current controller and has at least the default authority and the source of the request is queued."/>
								<internal/>
								<action name="queueHandoffRequest" interpretation="Adds the request for handoff identified by ID to the queue of clients requesting handoff.">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
								<!-- <action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'QUEUED' "/>
									<argument value="transportData"/>
								</action> -->
								<action name="sendRequestReleaseControl" interpretation="Sends a HandoffController.RequestReleaseControl message to the current controller">
									<argument value="msg"/>
									<argument value="transportData"/>
								</action>
							</transition>


							<!-- Remove Handoff Request -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="RemoveHandoffRequest" value="msg" interpretation="enveloped Remove Handoff Request message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isQueued( transportData )" interpretation="Returns True if the source of the request is queued."/>
								<internal/>
								<action name="removeHandoffRequest" interpretation="Removes the request for handoff identified by this client and ID from the queue of handoff requests and stops both the handoff request and handoff timers for this request.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to requesting client">
									<argument value=" 'REMOVED' "/>
									<argument value="transportData"/>
								</action>
							</transition>

							<!-- Confirm Release Control (output from HandoffController) -->
							<transition name="accessControl.events.transport.Receive">
								<parameter type="ConfirmReleaseControl" value="msg" interpretation="enveloped Confirm Release Control message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<internal/>
								<action name="processHandoffResponse" interpretation="">
									<argument value="msg"/>
									<argument value="transportData" interpretation="transportData of the client requesting handoff"/>
								</action>
