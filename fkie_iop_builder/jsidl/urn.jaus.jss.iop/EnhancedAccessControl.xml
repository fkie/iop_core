<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="EnhancedAccessControl" id="urn:jaus:jss:iop:EnhancedAccessControl" version="2.0"
	xmlns="urn:jaus:jsidl:1.1"
	xmlns:ns2="urn:jaus:jsidl:plus">
	<description xml:space="preserve">The EnhancedAccessControl service extends Access Control to allow for handoff of control from one client to another.  Below are typical sequences of events that are representative of the normal functioning of the service.

		*** INSERT DIAGRAMS ****
	</description>
	<assumptions xml:space="preserve">Messages may be delayed, lost, or reordered.</assumptions>
	<references>
		<inherits_from name="AccessControl" id="urn:jaus:jss:core:AccessControl" version="1.1"/>
		<client_of name="HandoffController" id="urn:jaus:jss:iop:HandoffController" version="2.0"/>
	</references>
	<message_set>
		<input_set>
			<declared_message_def name="ConfirmReleaseControl" declared_type_ref="HandoffController.ConfirmReleaseControl"/>
			<message_def name="RequestHandoff" message_id="FF41" is_command="true">
				<description xml:space="preserve">Creates or updates a request for control handoff from the current controlling client.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="RequestHandoffRec" optional="false">
						<fixed_field name="RequestID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Client-generated ID for tracking handoff requests."/>
						<fixed_field name="AuthorityCode" optional="false" field_units="one" field_type="unsigned byte">
							<value_set offset_to_lower_limit="false">
								<value_range lower_limit="0" lower_limit_type="inclusive" upper_limit="255" upper_limit_type="inclusive"/>
							</value_set>
						</fixed_field>
						<variable_length_string name="Explanation" optional="false">
							<count_field min_count="0" max_count="255" field_type_unsigned="unsigned byte"/>
						</variable_length_string>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
			<message_def name="QueryHandoffDecisionTimeout" message_id="FF42" is_command="false">
				<description xml:space="preserve">Causes the service to issue a ReportHandoffDecisionTimeout message.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body"/>
				<footer name="Footer"/>
			</message_def>
			<message_def name="QueryHandoffRequestTimeout" message_id="FF43" is_command="false">
				<description xml:space="preserve">Causes the service to issue a ReportHandoffRequestTimeout message.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body"/>
				<footer name="Footer"/>
			</message_def>
			<message_def name="RemoveHandoffRequest" message_id="FF44" is_command="true">
				<description xml:space="preserve">Remove a request for handoff control.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="RemoveHandoffRec" optional="false">
						<fixed_field name="RequestID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Client-generated ID for tracking handoff requests.  This should match an ID from a previous RequestHandoff message."/>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
		</input_set>
		<output_set>
			<declared_message_def name="RequestReleaseControl" declared_type_ref="HandoffController.RequestReleaseControl"/>
			<message_def name="ConfirmHandoffRequest" message_id="FF45" is_command="false">
				<description xml:space="preserve">Confirms that there is a response to a handoff request.  The response can be: GRANTED, meaning the request for handoff was granted and the requesting client has control; NOT_AVAILABLE, meaning control (and thus handoff) is not available; HANDOFF_REQUEST_TIMEOUT, meaning the handoff request timed out because it was not re-issued within a set amount of time to the handoff request; DENIED, meaning the current controlling client rejected the request for handoff; QUEUED, meaning the handoff request was queued and pending; DEFERRED, meaning the current controller is not prepared to make a decision on the request; INSUFFICIENT_AUTHORITY, meaning the request did not have a high enough authority code to control the service; HANDOFF_DECISION_TIMEOUT, meaning the current controller did not respond within a set amount of time to the handoff request;  SERVICE_NOT_CONTROLLED, meaning that the service is not currently being controlled; or REMOVED, meaning that the handoff request was removed from the queue.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="ConfirmHandoffRequestRec" optional="false">
						<fixed_field name="RequestID" optional="false" field_units="one" field_type="unsigned byte" interpretation="ID from the RequestHandoff message that established the handoff request."/>
						<fixed_field name="ResponseCode" optional="false" field_units="one" field_type="unsigned byte">
							<value_set offset_to_lower_limit="false">
								<value_enum enum_index="0" enum_const="GRANTED"/>
								<value_enum enum_index="1" enum_const="NOT_AVAILABLE"/>
								<value_enum enum_index="2" enum_const="HANDOFF_REQUEST_TIMEOUT"/>
								<value_enum enum_index="3" enum_const="DENIED"/>
								<value_enum enum_index="4" enum_const="QUEUED"/>
								<value_enum enum_index="5" enum_const="DEFERRED"/>
								<value_enum enum_index="6" enum_const="INSUFFICIENT_AUTHORITY"/>
								<value_enum enum_index="7" enum_const="HANDOFF_DECISION_TIMEOUT"/>
								<value_enum enum_index="8" enum_const="SERVICE_NOT_CONTROLLED"/>
								<value_enum enum_index="9" enum_const="REMOVED"/>
							</value_set>
						</fixed_field>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
			<message_def name="ReportHandoffDecisionTimeout" message_id="FF46" is_command="false">
				<description xml:space="preserve">Sent in response to a Query Handoff Decision Timeout message.  The handoff decision timeout is the amount of time that must pass between this service requesting a handoff from the current controlling client and this service receiving a ConfirmReleaseControl message in response before that handoff request is considered failed due to a timeout.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="ReportHandoffDecisionTimeoutRec" optional="false">
						<fixed_field name="HandoffDecisionTimeout" optional="false" field_units="second" field_type="unsigned byte" interpretation="The handoff decision timeout is the amount of time that must pass between this service requesting a handoff from the current controlling client and this service receiving a ConfirmReleaseControl message in response before that handoff request is considered failed due to a timeout.. A value of zero indicates this feature is disabled."/>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
			<message_def name="ReportHandoffRequestTimeout" message_id="FF47" is_command="false">
				<description xml:space="preserve">Sent in response to a Query Handoff Request Timeout message.  The handoff request timeout is the maximum amount of time between a client reasserting its desire for a handoff before that request for a handoff is considered timed out.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="ReportHandoffRequestTimeoutRec" optional="false">
						<fixed_field name="HandoffRequestTimeout" optional="false" field_units="second" field_type="unsigned byte" interpretation="The handoff request timeout is the maximum amount of time between a client reasserting its desire for a handoff before that request for a handoff is considered timed out. A value of zero indicates this feature is disabled."/>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
		</output_set>
	</message_set>
	<internal_events_set>
		<!-- <event_def name="HandoffDecisionTimeoutEvent">
			<description>Occurs when the current controller fails to respond to a RequestReleaseControl request within a certain amount of time.</description>
			<header name="Header" />
