<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="EnhancedAccessControl" id="urn:jaus:jss:iop:EnhancedAccessControl" version="2.0"
	xmlns="urn:jaus:jsidl:1.1"
	xmlns:ns2="urn:jaus:jsidl:plus">
	<description xml:space="preserve">The EnhancedAccessControl service extends Access Control to allow for handoff of control from one client to another.  Below are typical sequences of events that are representative of the normal functioning of the service.

		*** INSERT DIAGRAMS ****
	</description>
	<assumptions xml:space="preserve">Messages may be delayed, lost, or reordered.</assumptions>
	<references>
		<inherits_from name="AccessControl" id="urn:jaus:jss:core:AccessControl" version="1.1"/>
		<client_of name="HandoffController" id="urn:jaus:jss:iop:HandoffController" version="2.0"/>
	</references>
	<declared_type_set name="Types">
		<declared_type_set_ref name="messages" id="urn:jaus:jss:iop:MessageSet:EnhancedAccessControlSet" version="2.0"/>
		<declared_type_set_ref name="hcMessages" id="urn:jaus:jss:iop:MessageSet:HandoffControllerSet" version="2.0"/>
	</declared_type_set>
	<message_set>
		<input_set>
			<declared_message_def name="RequestHandoff" declared_type_ref="messages.RequestHandoff"/>
			<declared_message_def name="QueryHandoffDecisionTimeout" declared_type_ref="messages.QueryHandoffDecisionTimeout"/>
			<declared_message_def name="QueryHandoffRequestTimeout" declared_type_ref="messages.QueryHandoffRequestTimeout"/>
			<declared_message_def name="RemoveHandoffRequest" declared_type_ref="messages.RemoveHandoffRequest"/>
			<declared_message_def name="ConfirmReleaseControl" declared_type_ref="hcMessages.ConfirmReleaseControl"/>
		</input_set>
		<output_set>
			<declared_message_def name="ConfirmHandoffRequest" declared_type_ref="messages.ConfirmHandoffRequest"/>
			<declared_message_def name="ReportHandoffDecisionTimeout" declared_type_ref="messages.ReportHandoffDecisionTimeout"/>
			<declared_message_def name="ReportHandoffRequestTimeout" declared_type_ref="messages.ReportHandoffRequestTimeout"/>
			<declared_message_def name="RequestReleaseControl" declared_type_ref="hcMessages.RequestReleaseControl"/>
		</output_set>
	</message_set>
	<internal_events_set>
		<!-- <event_def name="HandoffDecisionTimeoutEvent">
