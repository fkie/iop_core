								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'DENIED' "/>
									<argument value="transportData" interpretation="transportData of the client requesting handoff"/>
								</action>
							</transition>

							<transition name="accessControl.events.transport.Receive">
								<parameter type="ConfirmReleaseControl" value="msg" interpretation="enveloped Confirm Release Control message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<guard condition="isControllingClient( transportData ) &amp;&amp; requestExists(transportData) &amp;&amp; isRequestDeferred(msg)" interpretation="Returns True if the confirming client is the current controller AND the request for release of control exists AND the request was DEFERRED."/>
								<internal/>
								<action name="resetHandoffDecisionTimer" interpretation="Resets the handoff decision timer associated with the corresponding RequestReleaseControl ID.">
									<argument value="transportData"/>
								</action>
								<action name="sendConfirmHandoffRequest" interpretation="Send a ConfirmHandoffRequest message to querying client">
									<argument value=" 'DEFERRED' "/>
									<argument value="transportData" interpretation="transportData of the client requesting handoff"/>
								</action>
							</transition> -->

							<!-- Handoff Request Timeout -->
							<!-- <transition name="HandoffRequestTimeoutEvent">
								<parameter type="unsigned byte" value="requestID" interpretation="ID from the Request Handoff message"/>
								<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
								<parameter type="unsigned byte" value="requestReleaseControlID" interpretation="ID from the Handoff Decision Timeout Event"/>
								<internal/>
								<action name="removeHandoffRequest" interpretation="Removes the request for handoff identified by this client and ID from the queue of handoff requests and stops both the handoff request and handoff timers for this request.">
