<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<service_def name="HandoffController" id="urn:jaus:jss:iop:HandoffController" version="2.0"
	xmlns="urn:jaus:jsidl:1.1"
	xmlns:ns2="urn:jaus:jsidl:plus">
	<description xml:space="preserve">The Handoff Controller service runs on an entity such as an OCU that support handing off control.</description>
	<assumptions xml:space="preserve">Messages may be delayed, lost, or reordered.</assumptions>
	<references>
		<inherits_from name="Transport" id="urn:jaus:jss:core:Transport" version="1.1"/>
		<client_of name="EnhancedAccessControl" id="urn:jaus:jss:iop:EnhancedAccessControl" version="2.0"/>
	</references>
	<message_set>
		<input_set>
			<message_def name="RequestReleaseControl" message_id="FF48" is_command="true">
				<description xml:space="preserve">This message is sent to the current controlling client to provide it with a request to handoff control.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="RequestReleaseControlRec" optional="false">
						<fixed_field name="ID" optional="false" field_units="one" field_type="unsigned byte" interpretation="ID from the client used to match this Request to its response."/>
						<fixed_field name="SrcSubsystemID" optional="false" field_units="one" field_type="unsigned short integer" interpretation="Subsystem ID of the source requesting the handoff.">
							<value_set offset_to_lower_limit="false">
								<value_range lower_limit="1" lower_limit_type="inclusive" upper_limit="65534" upper_limit_type="inclusive"/>
							</value_set>
						</fixed_field>
						<fixed_field name="SrcNodeID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Node ID of the source requesting the handoff.">
							<value_set offset_to_lower_limit="false">
								<value_range lower_limit="0" lower_limit_type="inclusive" upper_limit="254" upper_limit_type="inclusive"/>
							</value_set>
						</fixed_field>
						<fixed_field name="SrcComponentID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Component ID of the source requesting the handoff.">
							<value_set offset_to_lower_limit="false">
								<value_range lower_limit="0" lower_limit_type="inclusive" upper_limit="254" upper_limit_type="inclusive"/>
							</value_set>
						</fixed_field>
						<fixed_field name="AuthorityCode" optional="false" field_units="one" field_type="unsigned byte" interpretation="Authority of the source requesting the handoff."/>
						<variable_length_string name="Explanation" optional="false" interpretation="Reason the handoff is requested.">
							<count_field min_count="0" max_count="255" field_type_unsigned="unsigned byte"/>
						</variable_length_string>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
			<message_def name="RemoveRequestReleaseControl" message_id="FF49" is_command="true">
				<description xml:space="preserve">Remove a request for handoff control.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="RemoveRequestReleaseControlRec" optional="false">
						<fixed_field name="ID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Matches the ID from a RequestReleaseControlRec in the RequestReleaseControl message."/>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>

			<declared_message_def name="ConfirmHandoffRequest" declared_type_ref="EnhancedAccessControl.ConfirmHandoffRequest"/>
			<declared_message_def name="ReportHandoffDecisionTimeout" declared_type_ref="EnhancedAccessControl.ReportHandoffDecisionTimeout"/>
			<declared_message_def name="ReportHandoffRequestTimeout" declared_type_ref="EnhancedAccessControl.ReportHandoffRequestTimeout"/>
		</input_set>
		<output_set>
			<message_def name="ConfirmReleaseControl" message_id="FF4A" is_command="false">
				<description xml:space="preserve">Used by the controlling client to acknowledge the removal of a handoff request or to grant, deny, or defer a decision on that handoff request. At most, only one request should be GRANTED at a time.</description>
				<header name="JAUSApplicationLayerHeader">
					<record name="HeaderRec" optional="false">
						<fixed_field name="MessageID" optional="false" field_units="one" field_type="unsigned short integer"/>
					</record>
				</header>
				<body name="Body">
					<record name="ReleaseControlRec" optional="false">
						<fixed_field name="ID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Matches the ID from a RequestReleaseControlRec in the RequestReleaseControl message."/>
						<fixed_field name="ResponseCode" optional="false" field_units="one" field_type="unsigned byte">
							<value_set offset_to_lower_limit="false">
								<value_enum enum_index="0" enum_const="GRANTED"/>
								<value_enum enum_index="1" enum_const="DENIED"/>
								<value_enum enum_index="2" enum_const="WAIT"/>
								<value_enum enum_index="3" enum_const="REMOVED"/>
							</value_set>
						</fixed_field>
					</record>
				</body>
				<footer name="Footer"/>
			</message_def>
			<declared_message_def name="RequestHandoff" declared_type_ref="EnhancedAccessControl.RequestHandoff"/>
			<declared_message_def name="QueryHandoffDecisionTimeout" declared_type_ref="EnhancedAccessControl.QueryHandoffDecisionTimeout"/>
			<declared_message_def name="QueryHandoffRequestTimeout" declared_type_ref="EnhancedAccessControl.QueryHandoffRequestTimeout"/>
			<declared_message_def name="RemoveHandoffRequest" declared_type_ref="EnhancedAccessControl.RemoveHandoffRequest"/>
		</output_set>
	</message_set>
	<internal_events_set>
		<!-- <event_def name="HandoffDecisionMade">
			<description>Occurs when a decision on requested handoffs has been made.</description>
			<header name="Header" />
			<body name="Body">
				<record name="ReleaseControlRec" optional="false">
					<fixed_field name="ID" optional="false" field_units="one" field_type="unsigned byte" interpretation="Matches the ID from a RequestReleaseControlRec in the RequestReleaseControl message."/>
					<fixed_field name="ResponseCode" optional="false" field_units="one" field_type="unsigned byte">
						<value_set offset_to_lower_limit="false">
							<value_enum enum_index="0" enum_const="GRANTED"/>
							<value_enum enum_index="1" enum_const="DENIED"/>
							<value_enum enum_index="2" enum_const="WAIT"/>
							<value_enum enum_index="3" enum_const="REMOVED"/>
						</value_set>
					</fixed_field>
				</record>
			</body>
			<footer name="Footer" />
		</event_def> -->
	</internal_events_set>
	<protocol_behavior is_stateless="false">
		<start state_machine_name="transport.ReceiveFSM" state_name="Receiving" interpretation="Extending ReceiveFSM from base."/>
		<state_machine name="transport.ReceiveFSM" interpretation="redefine state in order to extend">
			<state name="Receiving">
				<default_state>
					<transition name="transport.Receive">
						<parameter type="RequestReleaseControl" value="msg" interpretation="enveloped Request Release Control message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="processHandoffRequest" interpretation="Process the handoff request, determining if it should be denied, accepted, or delayed.  This may involve displaying to the human operator all handoff requests so he can make his decision(s).  This could also mean 'convey for processing' in the case that a non-human operator is responding to the hand-off request.">
							<argument value="msg"/>
							<argument value="transportData"/>
						</action>
					</transition>

					<transition name="transport.Receive">
						<parameter type="RemoveRequestReleaseControl" value="msg" interpretation="enveloped Remove Request Release Control message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="removeRequestAndSendConfirmReleaseControl" interpretation="Send a ConfirmReleaseControl message to requesting client">
							<argument value="msg"/>
							<argument value="transportData"/>
						</action>
					</transition>

					<transition name="transport.Receive">
						<parameter type="ConfirmHandoffRequest" value="msg" interpretation="enveloped ConfirmHandoffRequest message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="processConfirmHandoffRequest" interpretation="Process the ConfirmHandoffRequest">
							<argument value="msg"/>
							<argument value="transportData"/>
						</action>
					</transition>

					<transition name="transport.Receive">
						<parameter type="ReportHandoffDecisionTimeout" value="msg" interpretation="enveloped ReportHandoffDecisionTimeout message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="processReportHandoffDecisionTimeout" interpretation="Process the ReportHandoffDecisionTimeout">
							<argument value="msg"/>
							<argument value="transportData"/>
						</action>
					</transition>

					<transition name="transport.Receive">
						<parameter type="ReportHandoffRequestTimeout" value="msg" interpretation="enveloped ReportHandoffRequestTimeout message"/>
						<parameter type="Receive.Body.ReceiveRec" value="transportData" interpretation="transportData"/>
						<internal/>
						<action name="processReportHandoffRequestTimeout" interpretation="Process the ReportHandoffRequestTimeout">
							<argument value="msg"/>
							<argument value="transportData"/>
						</action>
					</transition>
					<!-- <transition name="HandoffDecisionMade">
						<parameter type="HandoffDecisionMade.Body.ReleaseControlRec.ID" value="ID" interpretation="Matches the ID from a RequestReleaseControlRec in the RequestReleaseControl message."/>
						<parameter type="HandoffDecisionMade.Body.ReleaseControlRec.ResponseCode" value="response" interpretation="The response to the handoff request identified by ID"/>
						<internal/>
						<action name="sendConfirmReleaseControl" interpretation="Send a ConfirmReleaseControl message to requesting client">
							<argument value="ID"/>
							<argument value="response"/>
						</action>
					</transition> -->
				</default_state>
			</state>			<!--Receiving-->
		</state_machine>
	</protocol_behavior>
</service_def>
